// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`native-chat launch parity > antigravity floating fresh 1`] = `
{
  "child": {
    "args": [],
    "command": "<root>/bin/agy_acp_server.par",
    "cwd": "<root>/floating",
    "env": {
      "AGY_ACP_FORCE_FILE_STORAGE": "1",
      "ANTHROPIC_API_KEY": "parent-api-key",
      "BROWSER": "'/bin/sh' '-c' 'exec /usr/bin/env ELECTRON_RUN_AS_NODE=1 "$(printf %b '"'"'<node>'"'"')" -e '"'"'process.stderr.on("error",()=>process.exit(0)).write("__HIVEWARD_ANTIGRAVITY_AUTH_URL__"+JSON.stringify(process.argv[1])+"\\n",()=>process.exit(0))'"'"' -- "$1"' '--' '%s'",
      "CLAUDE_CODE_SESSION_ID": "parent-claude-session",
      "CLAUDE_CONFIG_DIR": "/parent/claude",
      "CODEX_HOME": "/parent/codex",
      "GEMINI_HOME": "<root>/accounts/antigravity",
      "HIVEWARD_AGENT_SESSION_ID": "00000000-0000-4000-8000-000000000033",
      "HIVEWARD_AGENT_SESSION_SPAWN_TOKEN": "parity-spawn-token",
      "HIVEWARD_CLI_BIN_DIR": "<root>/hiveward-cli/bin",
      "HIVEWARD_CLI_COMMAND": "<root>/hiveward-cli/bin/hiveward",
      "HIVEWARD_DATA_ACCOUNT_PROVIDER": "parent-account",
      "HIVEWARD_ENVIRONMENT": "",
      "HIVEWARD_OPENCODE_CONFIG_DIR": "/parent/opencode-overlay",
      "HIVEWARD_PAIRING_CODE": "",
      "HIVEWARD_REMOTE_PAIRING": "",
      "HIVEWARD_STRUCTURED_SESSION": "1",
      "HIVEWARD_TERMINAL_HANDLE": "term_parent",
      "HIVEWARD_USER_DATA_PATH": "<root>/user-data",
      "HOME": "<root>/home",
      "INHERITED_ONLY": "process",
      "LANG": "en_US.UTF-8",
      "PARITY_OVERLAY": "antigravity",
      "PATH": "<root>/hiveward-cli/bin:<root>/bin:/opt/login-shell/bin:/usr/bin:/bin",
      "PYTHONUNBUFFERED": "1",
      "SHELL_ONLY": "shell",
      "SHELL_UNLISTED": "shell",
      "TEMP": "<root>/state/acp-temp/antigravity/run-<random>",
      "TMP": "<root>/state/acp-temp/antigravity/run-<random>",
      "TMPDIR": "<root>/state/acp-temp/antigravity/run-<random>",
    },
    "envToDelete": [
      "HIVEWARD_AGENT_HOOK_ENDPOINT",
      "HIVEWARD_AGENT_HOOK_ENV",
      "HIVEWARD_AGENT_HOOK_PORT",
      "HIVEWARD_AGENT_HOOK_TOKEN",
      "HIVEWARD_AGENT_HOOK_TRANSPORT",
      "HIVEWARD_AGENT_HOOK_VERSION",
      "HIVEWARD_AGENT_LAUNCH",
      "HIVEWARD_AGENT_LAUNCH_TOKEN",
      "HIVEWARD_AGENT_PANE",
      "HIVEWARD_CHAT_SCRATCH_DIR",
      "HIVEWARD_CHAT_VISUALS_DIR",
      "HIVEWARD_CLAUDE_AGENT_STATUS_SETTINGS",
      "HIVEWARD_PANE_KEY",
      "HIVEWARD_TAB_ID",
      "HIVEWARD_WORKTREE_ID",
    ],
    "supervisor": {
      "closeRequest": "stdin-end",
      "cwd": "<root>/floating",
      "lifetime": "session",
      "nodeEnv": {
        "NODE_OPTIONS": "--max-old-space-size=4096",
      },
    },
  },
  "launchPosture": {
    "fullAccess": false,
  },
  "pinnedLaunchDirectories": [
    "<root>/floating",
  ],
}
`;

